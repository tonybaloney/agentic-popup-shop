{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "webAppExists": {
      "value": "${SERVICE_WEB_RESOURCE_EXISTS=false}"
    },
    "apiAppExists": {
      "value": "${SERVICE_API_RESOURCE_EXISTS=false}"
    },
    "supplierMcpAppExists": {
      "value": "${SERVICE_SUPPLIER_MCP_RESOURCE_EXISTS=false}"
    },
    "financeMcpAppExists": {
      "value": "${SERVICE_FINANCE_MCP_RESOURCE_EXISTS=false}"
    },
    "keycloakAppExists": {
      "value": "${SERVICE_KEYCLOAK_RESOURCE_EXISTS=false}"
    },
    "keycloakAdminPassword": {
      "value": "${KEYCLOAK_ADMIN_PASSWORD}"
    },
    "keycloakClientSecret": {
      "value": "${KEYCLOAK_CLIENT_SECRET}"
    },
    "chatkitDomainKey": {
      "value": "${CHATKIT_DOMAIN_KEY}"
    },
    "copilotStudioUrl": {
      "value": "${COPILOT_STUDIO_URL=}"
    },
    "aiModelName": {
      "value": "${AZURE_AI_MODEL_NAME=gpt-5-mini}"
    },
    "aiModelVersion": {
      "value": "${AZURE_AI_MODEL_VERSION=2025-08-07}"
    }
  }
}